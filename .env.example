# Genesis storefront — environment template.
# Copy to .env.local (or .env) for local development. Never commit real values.
# Production: Vercel → storefront project → Settings → Environment Variables,
# for Production and Preview. NEXT_PUBLIC_ values are built into the site's
# JavaScript at build time: after changing one, redeploy.
# Only public values belong here. No secrets (none are needed).

# Required. Backend origin; the app adds /api/v1. Live: https://genesis-backend-ajbs.onrender.com
# There is no default: the app refuses to start or build without a valid URL,
# and a Vercel build refuses anything that isn't a public https address.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Required (a production build refuses to run without it).
# Google Cloud → Credentials → OAuth 2.0 Web client ID.
# Must be identical to the backend's GOOGLE_CLIENT_ID. Its Authorized JavaScript
# origins must include this site's address(es). No redirect URI is needed.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Optional. Public address used for metadata, sitemap and robots.
# Defaults to https://genesisbypreethy.com
# NEXT_PUBLIC_SITE_URL=https://genesisbypreethy.com
